{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:persistence && npm run test:api",
    "test:api": "node --test --test-concurrency=1 tests/api/base-server.test.js tests/api/auth.test.js",
    "test:integrity": "node scripts/test-integrity.js",
    "integration:verify": "node scripts/verify-cross-db-integrity.js",
    "verify:persistence": "npm run seed:verify && npm run integration:verify && npm run queries:verify && npm test",
    "evidence:persistence": "node scripts/collect-persistence-evidence.js",
    "test:integration": "node --test --test-concurrency=1 database/tests/integration/persistence-integration.test.js",
    "test:persistence": "npm run test:integrity && npm run test:integration && npm run test:queries",
    "queries:verify": "node scripts/verify-critical-queries.js",
    "test:queries": "node --test --test-concurrency=1 database/tests/queries/persistence-queries.test.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "postgres:test": "node database/postgres/health-test.js",
    "mongo:indexes": "node database/mongodb/sync-indexes.js",
    "mongo:seed": "node database/mongodb/seeds/development.js",
    "mongo:test": "node database/mongodb/smoke-test.js",
    "mongo:health": "node database/mongodb/health-test.js",
    "seed:dev": "node scripts/seed-dev.js",
    "seed:verify": "node scripts/verify-dev-seed.js",
    "env:sync": "node scripts/sync-dev.js",
    "env:fresh": "node scripts/fresh-dev.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
